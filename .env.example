# Optional. Without it the agent uses its built-in rules and templates.
ANTHROPIC_API_KEY=
# Optional: override the model (see https://platform.claude.com/docs/en/about-claude/models/overview)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Your own domains, comma-separated. UTMs on links that start AND end on these are flagged as internal tagging.
INTERNAL_DOMAINS=acme.example,www.acme.example
# Campaign naming pattern (regex). Default: year-quarter-theme, e.g. 2026-q4-demo-push
CAMPAIGN_PATTERN=^20[0-9]{2}-q[1-4]-[a-z0-9]+(-[a-z0-9]+)*$
